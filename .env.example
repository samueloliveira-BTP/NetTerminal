# Copie este arquivo para ".env" (na mesma pasta do NETerminal.exe) e ajuste.
# NUNCA coloque senhas ou tokens aqui: o .env não é criptografado.

# --- Atualização automática (vazio = desligada) ---------------------------
# Precisa ser HTTPS. O JSON deve trazer: versao, url_download, sha256 (obrigatório).
UPDATE_CHECK_URL=
# Hosts extras permitidos para o download (separados por vírgula).
# Por padrão só o mesmo host do UPDATE_CHECK_URL é aceito.
UPDATE_ALLOWED_HOSTS=
# Exige assinatura digital (Authenticode) válida no instalador. Recomendado
# assim que a empresa tiver um certificado de assinatura de código.
UPDATE_REQUIRE_SIGNATURE=false
# Trecho que deve aparecer no "Subject" do certificado (ex.: O=Minha Empresa).
UPDATE_SIGNER_SUBJECT=

# --- Sessões -------------------------------------------------------------
# Minutos sem uso até desconectar a sessão automaticamente.
SESSION_IDLE_TIMEOUT_MIN=10
# Pede confirmação antes de colar texto com várias linhas no terminal.
CONFIRM_MULTILINE_PASTE=true
# Linhas mantidas na tela de cada aba.
TERMINAL_SCROLLBACK_LINES=20000

# --- Monitor de status ---------------------------------------------------
MONITOR_INTERVAL_SEC=15
MONITOR_WORKERS=32

# --- Logs e auditoria ----------------------------------------------------
# Dias para manter logs JÁ ROTACIONADOS (0 = nunca apagar).
# Definir conforme a política de retenção aprovada pelo responsável de LGPD.
LOG_RETENTION_DAYS=0
# Envia cada comando auditado também para um syslog central (UDP).
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
