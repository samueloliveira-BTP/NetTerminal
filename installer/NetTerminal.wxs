<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI do NetTerminal (WiX Toolset v4 ou mais novo).
  Gere com:  powershell -ExecutionPolicy Bypass -File installer\build_msi.ps1

  * Instalação POR USUÁRIO em %LOCALAPPDATA%\Programs\NetTerminal: não pede
    administrador, o que permite a atualização silenciosa pelo próprio app.
  * Atalho no Menu Iniciar (sempre) e na Área de Trabalho (ATALHO_DESKTOP=1).
  * MajorUpgrade: instalar uma versão nova substitui a antiga automaticamente.
  * Os dados do usuário (~/.olt_manager) NÃO são tocados na instalação nem
    na desinstalação.

  IMPORTANTE: nunca altere o UpgradeCode — é ele que identifica o produto
  entre versões.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NetTerminal"
           Manufacturer="Brasiltecpar"
           Version="$(var.Versao)"
           UpgradeCode="{728B1217-4F51-4FB9-B89F-063CEE9711FE}"
           Scope="perUser"
           Language="1046"
           Compressed="yes">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Uma versão mais nova do NetTerminal já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="NetTerminal.ico" SourceFile="..\assets\icone.ico" />
    <Property Id="ARPPRODUCTICON" Value="NetTerminal.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ATALHO_DESKTOP" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NetTerminal" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Principal" Title="NetTerminal" Level="1">

      <Component Id="Executavel" Directory="INSTALLFOLDER" Guid="{2E3C5E0B-6A4B-4C5E-9B1A-3F7D2C8E9A01}">
        <File Id="NETerminalExe" Source="..\dist\NETerminal.exe" />
        <RegistryValue Root="HKCU" Key="Software\NetTerminal" Name="Executavel" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoverPastaInstalacao" On="uninstall" />
        <RemoveFolder Id="RemoverPastaPrograms" Directory="ProgramsFolder" On="uninstall" />
      </Component>

<?if $(var.IncluirEnv) = "1" ?>
      <!-- Configuração da empresa (.env), se existir na raiz do projeto no momento do build -->
      <Component Id="ArquivoEnv" Directory="INSTALLFOLDER" Guid="{7C1F4A92-3D58-4E0B-A6C4-91B2D5E8F310}">
        <File Id="ArquivoEnv" Source="..\.env" Name=".env" />
        <RegistryValue Root="HKCU" Key="Software\NetTerminal" Name="Env" Type="integer" Value="1" KeyPath="yes" />
      </Component>
<?endif?>

      <Component Id="AtalhoMenuIniciar" Directory="ProgramMenuFolder" Guid="{B5D0E7A1-8C2F-4F39-9E6D-0A4C7B3E5D22}">
        <Shortcut Id="AtalhoMenu" Name="NetTerminal" Description="Gerenciador de Ativos de Rede"
                  Target="[INSTALLFOLDER]NETerminal.exe" WorkingDirectory="INSTALLFOLDER" Icon="NetTerminal.ico" />
        <RegistryValue Root="HKCU" Key="Software\NetTerminal" Name="AtalhoMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="AtalhoAreaDeTrabalho" Directory="DesktopFolder" Guid="{E9A3C6F4-1B7D-4D82-8F05-6C2B9A4E7D13}"
                 Condition="ATALHO_DESKTOP = 1">
        <Shortcut Id="AtalhoDesktop" Name="NetTerminal" Description="Gerenciador de Ativos de Rede"
                  Target="[INSTALLFOLDER]NETerminal.exe" WorkingDirectory="INSTALLFOLDER" Icon="NetTerminal.ico" />
        <RegistryValue Root="HKCU" Key="Software\NetTerminal" Name="AtalhoDesktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
